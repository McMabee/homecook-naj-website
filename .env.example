# Copy this file to .env.local and fill in the values.
# Both values are baked into the client bundle at build time (that is how VITE_ vars work),
# so set them in your hosting provider's environment settings as well when you deploy.

# Contact form endpoint (FormSubmit, https://formsubmit.co).
# Use Naj's real email. The first submission triggers a one-time activation email to that
# address; after activating you can swap the email for the random alias FormSubmit gives you.
VITE_FORMSUBMIT_ENDPOINT=https://formsubmit.co/ajax/naj@example.com

# Password for the hidden recipe admin page (the tiny dot at the bottom-right of the footer).
# This only hides the page from casual visitors. It is NOT real security.
VITE_ADMIN_PASSWORD=change-me

VITE_SUPABASE_URL=update-this
VITE_SUPABASE_PUBLISHABLE_KEY=this-too

DATABASE_PASSWORD=this-as-well
